<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin the package source for local development and CI so restores are
    deterministic. Public NuGet.org only; no private feed is used
    (see docs/specs/SPEC-001-health-endpoint-and-ci-bootstrap.md).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
